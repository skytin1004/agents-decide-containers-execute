# Copy values into your shell or a local .env. Never commit .env.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_NAME=YOUR-EXISTING-MODEL-DEPLOYMENT
FOUNDRY_HOSTED_AGENT_NAME=docops-agent
AZURE_STORAGE_ACCOUNT=YOUR-STORAGE-ACCOUNT
# Optional viewer link; use the ARM resource ID of that same storage account.
AZURE_STORAGE_RESOURCE_ID=/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-RESOURCE-GROUP/providers/Microsoft.Storage/storageAccounts/YOUR-STORAGE-ACCOUNT
DOCOPS_QUEUE=docops-work
DOCOPS_POISON_QUEUE=docops-poison
DOCOPS_CONTAINER=docops-results
# Set only for the worker user-assigned identity. Hosted agents use their own identity.
AZURE_CLIENT_ID=
